<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>project_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>project_shm</transport_id>
      <type>SHM</type>
      <!-- Allow multiple stereo image payloads to remain in flight. -->
      <segment_size>16777216</segment_size>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="project_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>project_udp</transport_id>
        <transport_id>project_shm</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
